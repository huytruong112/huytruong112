# Cấu hình môi trường cho VPN Service

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your_secret_api_key_here

# X-UI Panel 1
XUI_SERVER1_URL=https://your-xui-server.com:54321
XUI_SERVER1_USERNAME=admin
XUI_SERVER1_PASSWORD=your_password
XUI_SERVER1_INBOUND_ID=1

# 3X-UI Panel 1
THREEXUI_SERVER1_URL=https://your-3xui-server.com:2053
THREEXUI_SERVER1_USERNAME=admin
THREEXUI_SERVER1_PASSWORD=your_password
THREEXUI_SERVER1_INBOUND_ID=1

# 3X-UI Panel 2
THREEXUI_SERVER2_URL=https://your-3xui-server2.com:2053
THREEXUI_SERVER2_USERNAME=admin
THREEXUI_SERVER2_PASSWORD=your_password
THREEXUI_SERVER2_INBOUND_ID=1

# Database (optional)
DATABASE_URL=sqlite:///./vpn_customers.db

# Logging
LOG_LEVEL=INFO
