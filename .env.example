# Database Configuration
DATABASE_URL=sqlite:///./vpn_service.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/vpn_service

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# X-UI Panel 1 (dopaemon/x-ui)
XUI_1_URL=http://your-server-ip:54321
XUI_1_USERNAME=admin
XUI_1_PASSWORD=admin
XUI_1_ENABLED=true

# 3X-UI Panel (mhsanaei/3x-ui)
XUI_2_URL=http://your-server-ip:2053
XUI_2_USERNAME=admin
XUI_2_PASSWORD=admin
XUI_2_ENABLED=true

# Service Default Settings
DEFAULT_TRAFFIC_LIMIT_GB=50
DEFAULT_EXPIRY_DAYS=30

# Redis (for background tasks - optional)
REDIS_URL=redis://localhost:6379/0
