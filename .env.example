# Database Configuration
DATABASE_URL=sqlite:///./xui_manager.db

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=True

# X-UI Panel Configuration
XUI_PANEL_URL=http://your-server-ip:54321
XUI_USERNAME=admin
XUI_PASSWORD=admin

# 3X-UI Panel Configuration (alternative)
# Leave empty if using X-UI
THREE_XUI_PANEL_URL=http://your-server-ip:2053
THREE_XUI_USERNAME=admin
THREE_XUI_PASSWORD=admin

# Panel Type: xui or 3xui
PANEL_TYPE=3xui

# Service Configuration
DEFAULT_TRAFFIC_GB=100
DEFAULT_EXPIRY_DAYS=30
DEFAULT_PORT=443
DEFAULT_PROTOCOL=vless
